library(JMdesign)
# --- Buscar N minimo con potencia entre 0.80 y 0.90 ---
buscar_N <- function(beta, alpha) {
for (N in seq(50, 1000, by = 10)) {
nevents <- round(N * ev_rate)
power <- powerLongSurv(N, nevents, tmedian, meantf, p, t,
SigmaTheta, sigmae_2, ordtraj, beta, alpha)@power
if (power >= 0.80 && power <= 0.90) {
return(data.frame(beta, alpha, N, nevents, power))
}
}
data.frame(beta, alpha, N = NA, nevents = NA, power = NA)
}
# orden trayectoria
o = 2
t          <- c(2:6) ^ 2 / 12           # meses 4, 9, 16, 25 y 36 de prescripción médica
p          <- c(1, 0.30, 0.15, 0.10, 0.05)  # proporción de paciente que recibirán prescripción
SigmaTheta <- diag(1, nrow = o + 1)  # Matriz de covarianzas de theta, se asumen varianzas iguales y correlación nula entre intercepto y pendiente
sigmae_2   <- 1              # Varianza del error de medición
ordtraj    <- o              # orden de las trayectoria (0 constante, 1 lineal y 2 cuadrático)
tmedian    <- 2              # Cantidad de años estimada para el fallecimiento por ERC
meantf     <- 1.5            # Tiempo medio de seguimiento
ev_rate    <- 0.5            # proporcion de N que son eventos
# --- Betas y alphas a evaluar ---
betas  <- c(0.15, 0.20, 0.25, 0.30)
alphas <- c(0.01, 0.05, 0.10)
resultados <- do.call(rbind, Map(buscar_N,
rep(betas, each = length(alphas)),
rep(alphas, times = length(betas))))
